# Database configuration (Postgres/SQLite connection string)
DATABASE_URL=

# 32-byte hex string used for AES-256-GCM encryption of sensitive secrets
# Generate one using `openssl rand -hex 16`
ENCRYPTION_KEY=

# Base URL for the application (e.g., http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Pusher credentials for real-time UI updates
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# (Deprecated) Global fallback Resend Key. Prefer storing keys in the DB via Settings UI.
RESEND_API_KEY=
