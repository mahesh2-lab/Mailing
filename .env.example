# Shared PostgreSQL and BullMQ-compatible Redis service URLs.
DATABASE_URL=
REDIS_URL=

# Generate secret values with `openssl rand -hex 32`; do not rotate ENCRYPTION_KEY after saving API keys.
ENCRYPTION_KEY=

# Your Vercel production URL
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-project.vercel.app

# Project-scoped Better Auth Sentinel identify endpoint (use the value from project settings).
BETTER_AUTH_KV_URL=https://kv.better-auth.com/projects/your-project-id
NEXT_PUBLIC_BETTER_AUTH_KV_URL=https://kv.better-auth.com/projects/your-project-id

# Required Pusher credentials for real-time updates
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=
PUSHER_KEY=
PUSHER_CLUSTER=

# Required for workflow email sending; do not use a built-in default.
INTERNAL_API_SECRET=

# Optional AI automation provider
GEMINI_API_KEY=
